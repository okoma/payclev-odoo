<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payclev_bridge" model="res.groups">
        <field name="name">Payclev Accounting Bridge</field>
        <field name="comment">Permits the dedicated integration user to invoke the narrow Payclev payment bridge.</field>
    </record>
    <record id="rule_payclev_bridge_company" model="ir.rule">
        <field name="name">Payclev payment identities: allowed companies</field>
        <field name="model_id" ref="model_payclev_payment_bridge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payclev_bridge'))]"/>
    </record>
    <record id="rule_payclev_payment_option_company" model="ir.rule">
        <field name="name">Payclev payment options: allowed companies</field>
        <field name="model_id" ref="model_payclev_payment_option"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
    <record id="rule_payclev_invoice_context_company" model="ir.rule">
        <field name="name">Payclev invoice context: allowed companies</field>
        <field name="model_id" ref="model_payclev_invoice_context"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="rule_payclev_invoice_event_company" model="ir.rule">
        <field name="name">Payclev invoice activity: allowed companies</field>
        <field name="model_id" ref="model_payclev_invoice_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
</odoo>
